[Unit]
Description=Avci yeni.avcieticaret.com v2 Node app
After=network.target

[Service]
Type=simple
User=avccom
Group=avccom
WorkingDirectory=/home/avccom/yeni/v2/app
Environment=PATH=/opt/node-v22.23.1-linux-x64/bin:/usr/bin
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_BASE_PATH=/v2
Environment=NEXT_PUBLIC_SITE_ORIGIN=https://yeni.avcieticaret.com
Environment=AVCI_DOMAIN_STAGE=temporary
Environment=AVCI_TEMPORARY_CONTROL_PLANE_ORIGIN=https://yeni.avcieticaret.com/v2
Environment=AVCI_CANONICAL_ORIGIN=https://avcieticaret.com
Environment=CUSTOMER_PORTAL_PREVIEW=1
EnvironmentFile=-/home/avccom/yeni/hub-bridge.env
EnvironmentFile=-/home/avccom/yeni/admin-runtime.env
EnvironmentFile=-/home/avccom/yeni/v2/app/.dev.vars
Environment=WRANGLER_LOG_PATH=/home/avccom/yeni/v2/app/.wrangler/wrangler.log
Environment=AVCI_SQLITE_PATH=/home/avccom/yeni/data/avci-v2.sqlite
ExecStartPre=/opt/node-v22.23.1-linux-x64/bin/node /home/avccom/yeni/v2/app/scripts/migrate-node-sqlite.mjs
ExecStart=/opt/node-v22.23.1-linux-x64/bin/node /home/avccom/yeni/v2/app/node_modules/vinext/dist/cli.js start -H 127.0.0.1 -p 4121
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
