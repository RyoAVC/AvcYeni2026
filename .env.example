# Comma-separated ChatGPT account emails allowed to access /yonetim/basvurular.
# Configure the real value through Sites runtime settings; do not commit secrets.
ADMIN_EMAILS=admin@example.com

# Domain yayın sözleşmesi. Ana domain bakımdayken `temporary` kalmalıdır.
AVCI_DOMAIN_STAGE=temporary
AVCI_TEMPORARY_CONTROL_PLANE_ORIGIN=https://yeni.avcieticaret.com/v2
AVCI_CANONICAL_ORIGIN=https://avcieticaret.com

# Local password login for /yonetim/giris. Copy into ignored `.dev.vars`.
# ADMIN_LOGIN_EMAIL=local-admin@example.com
# ADMIN_LOGIN_PASSWORD=
# ADMIN_SESSION_SECRET=

# Local Vite preview only. Copy these two lines into ignored `.dev.vars`.
# Never set LOCAL_ADMIN_BYPASS in production.
# LOCAL_ADMIN_BYPASS=1
# ADMIN_EMAILS=local-admin@example.com

# Yerel müşteri paneli (parolasız, salt okunur). Yalnızca loopback'te çalışır.
# CUSTOMER_PORTAL_DEV=1
# CUSTOMER_SESSION_SECRET=

# Yerel /yonetim önizlemesi (parolasız test girişi). Yalnızca loopback'te çalışır;
# ADMIN_LOGIN_EMAIL/PASSWORD/ADMIN_SESSION_SECRET zaten yapılandırılmış olmalı.
# Never set ADMIN_PANEL_LOCAL_PREVIEW in production.
# ADMIN_PANEL_LOCAL_PREVIEW=1
# Canlı gizli önizleme (menüde yok; sunucuda CUSTOMER_PORTAL_PREVIEW=1 gerekir):
# CUSTOMER_PORTAL_PREVIEW=1
# Gizli önizleme (menüde yok): /onizleme/musteri-portali-k7m2x9

# Public HTTPS origin of the central license platform. The site redirects to /giris on this origin.
LICENSE_PORTAL_URL=https://license.example.com

# Avcı Commerce merkez lisans imzalayıcısı. Yalnız sunucu secret ayarlarında tutulur.
# COMMERCE_LICENSE_PRIVATE_KEY_PKCS8=
# COMMERCE_LICENSE_PUBLIC_KEY=

# Mobil push cihaz token kasası. En az 32 karakterlik rastgele değer üretin ve
# yalnız runtime secret olarak saklayın; istemciye veya git deposuna koymayın.
# MOBILE_PUSH_ENCRYPTION_KEY=
# EXPO_ACCESS_TOKEN=

# AvcAI (optional, free). Copy into ignored `.dev.vars`.
# OpenAI Realtime: live, low-latency voice. Keep this server-side; never expose it in browser code.
# OPENAI_API_KEY=
# Gemini: chat + Turkish voice. Create at https://aistudio.google.com/apikey
# GEMINI_API_KEY=
# Groq: chat only, no Turkish voice. Create at https://console.groq.com/keys
# GROQ_API_KEY=

# PayTR / SMTP preparation. Test-only; checkout endpoints not yet enabled.
# Set in ignored .env.local and explicitly load into the Node process.
# PAYMENT_PROVIDER selects the active adapter in app/payment-provider.mjs (default: paytr).
# iyzico has no adapter config yet — app/payment-provider-iyzico.mjs is a skeleton with no network calls.
# PAYMENT_PROVIDER=paytr
PAYTR_TEST_MODE=1
# PAYTR_MERCHANT_ID=
# PAYTR_MERCHANT_KEY=
# PAYTR_MERCHANT_SALT=
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=info@avcieticaret.com
# SMTP_PASS=
# SMTP_FROM=info@avcieticaret.com
# CHECKOUT_TEST_EMAIL=mahirtaksi4@gmail.com
# CHECKOUT_PUBLIC_URL=https://your-test-host.example